# Google AI Studio key (required) - powers Gemini chat + embeddings
GOOGLE_API_KEY=your_google_api_key

# Default Gemini model (optional)
GOOGLE_MODEL=gemini-3.5-flash

# Tavily key (required) - powers live web search
TAVILY_API_KEY=your_tavily_api_key

# OpenWeatherMap key (required) - powers the weather tool
OPENWEATHER_API_KEY=your_openweather_api_key

# LangSmith observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=astragpt
